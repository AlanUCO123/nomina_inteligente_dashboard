# ============================================================================
# Configuración SMTP para NOVA HE Control
# ============================================================================
# 
# IMPORTANTE:
#   1. Copiar este archivo a .env
#   2. Reemplazar valores con credenciales reales
#   3. NUNCA commitear .env a Git
#   4. Agregar .env a .gitignore
#
# ============================================================================

# Servidor SMTP
# Ejemplos:
#   - Gmail: smtp.gmail.com
#   - Office 365: smtp.office365.com
#   - SendGrid: smtp.sendgrid.net
#   - AWS SES: email-smtp.REGION.amazonaws.com
SMTP_SERVER=smtp.gmail.com

# Puerto SMTP
# Generalmente: 587 (STARTTLS) o 465 (SSL)
SMTP_PORT=587

# Usuario para autenticación SMTP
# Gmail: tu_email@gmail.com
# Office 365: usuario@empresa.com
# SendGrid: apikey
# AWS SES: AKIA...
SMTP_USER=tu_email@gmail.com

# Contraseña para autenticación SMTP
# Gmail: Usar contraseña de aplicación (no tu contraseña principal)
# Office 365: Tu contraseña corporativa
# SendGrid: Tu API Key
# AWS SES: SMTP password generada en AWS
SMTP_PASSWORD=tu_contraseña_aqui

# Email remitente (aparecerá como "De:" en emails)
# Recomendación: usar email corporativo o noreply@empresa.com
SMTP_FROM=nova@wyny.mx

# ============================================================================
# Cómo obtener credenciales por proveedor
# ============================================================================

# --- GMAIL ---
# 1. Habilitar 2FA en https://myaccount.google.com/security
# 2. Generar contraseña de aplicación en:
#    https://myaccount.google.com/apppasswords
# 3. Usar contraseña generada (sin espacios)
# 
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_email@gmail.com
# SMTP_PASSWORD=xxxxxxxx xxxx xxxx xxxx (sin espacios)

# --- OFFICE 365 / OUTLOOK ---
# SMTP_SERVER=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=usuario@empresa.com
# SMTP_PASSWORD=tu_contraseña

# --- SENDGRID ---
# 1. Crear cuenta en sendgrid.com
# 2. Generar API Key en Settings > API Keys
# 
# SMTP_SERVER=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxx

# --- AWS SES ---
# 1. Verificar dominio/email en SES Console
# 2. Generar SMTP credentials en Settings > SMTP Configuration
# 
# SMTP_SERVER=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=AKIA...
# SMTP_PASSWORD=...

# ============================================================================
# Configuración de ejemplo para pruebas
# ============================================================================
# 
# Si solo quieres probar, usa credenciales de Mailtrap:
# 1. Ir a https://mailtrap.io
# 2. Crear cuenta gratuita
# 3. Copiar SMTP credentials
# 
# SMTP_SERVER=smtp.mailtrap.io
# SMTP_PORT=465 o 2525
# SMTP_USER=tu_usuario
# SMTP_PASSWORD=tu_password
#
# ============================================================================
